@@ -275,6 +275,65 @@ object NvPlayer {
         c.addView(v, FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT))
         quadroView = v; quadroVisivel = true
     }
+    // Custom Stretch (CustomStretch.kt). player.c polls stretchCrop() while that aspect mode is on.
+    // Every poll may start one PixelCopy of the video Surface (never more often than the tracker's
+    // interval); the answer is the picture area found so far, as permille packed
+    // left | top << 10 | right << 20 | bottom << 30, with bit 62 set. 0 = not known (yet).
+    // The Surface holds the whole decoded frame whatever the window crop, so the fractions stay
+    // frame-relative. Subtitles are drawn by the C layer and are not part of the capture.
+    private val barras = BlackBarTracker()
+    private var barrasSessao = -1
+    private var barrasUrl = ""
+    private var barrasProximo = 0L
+    private var barrasCapturando = false
+    @Synchronized @JvmStatic fun stretchCrop(): Long {
+        val agora = SystemClock.elapsedRealtime()
+        if (sessao != barrasSessao || urlAtual != barrasUrl) {
+            barras.reset()
+            barrasSessao = sessao; barrasUrl = urlAtual
+            barrasProximo = agora + BlackBarTracker.FIRST_SAMPLE_DELAY_MS
+        }
+        if (!barrasCapturando && agora >= barrasProximo) principal.post { stretchAmostrar() }
+        val r = barras.current ?: return 0L
+        fun pm(f: Float) = Math.round(f * 1000f).coerceIn(0, 1000).toLong()
+        return (1L shl 62) or pm(r.left) or (pm(r.top) shl 10) or (pm(r.right) shl 20) or (pm(r.bottom) shl 30)
+    }
+    private fun stretchAmostrar() {
+        val minha = sessao
+        val sv: SurfaceView
+        synchronized(this) {
+            if (barrasCapturando || SystemClock.elapsedRealtime() < barrasProximo) return
+            sv = superficie ?: return
+            if (!quadroVisto || !sv.holder.surface.isValid || sv.width <= 0 || sv.height <= 0) return
+            barrasCapturando = true
+        }
+        val escala = BlackBarTracker.SAMPLE_MAX_DIMENSION.toFloat() / maxOf(sv.width, sv.height)
+        val b = try {
+            Bitmap.createBitmap(
+                Math.round(sv.width * escala).coerceAtLeast(8), Math.round(sv.height * escala).coerceAtLeast(8),
+                Bitmap.Config.ARGB_8888)
+        } catch (_: OutOfMemoryError) { synchronized(this) { barrasCapturando = false }; return }
+        try {
+            PixelCopy.request(sv, b, { resultado ->
+                val amostra = if (resultado == PixelCopy.SUCCESS)
+                    BlackBarDetector.detect(BlackBarDetector.lumaOf(b), b.width, b.height) else null
+                b.recycle()
+                synchronized(this) {
+                    barrasCapturando = false
+                    if (minha == sessao && barrasSessao == sessao) {
+                        if (barras.offer(amostra)) Log.i(TAG, "[stretch] area ${barras.current}")
+                        barrasProximo = SystemClock.elapsedRealtime() +
+                            if (barras.isCalibrating) BlackBarTracker.CALIBRATION_INTERVAL_MS
+                            else BlackBarTracker.STEADY_INTERVAL_MS
+                    }
+                }
+            }, principal)
+        } catch (_: Exception) {
+            b.recycle()
+            synchronized(this) { barrasCapturando = false; barrasProximo = SystemClock.elapsedRealtime() + 2_000L }
+        }
+    }
+
